# Copy to .env and fill in. Never commit .env.

# "keyword" (no-LLM mode, default, works offline) or "llm" (Gemini proposes moments, code verifies)
ONRECORD_MODE=keyword

# Only needed when ONRECORD_MODE=llm. Get one at https://aistudio.google.com/apikey
# Free tier: send ONLY public transcripts. Never send non-public data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Where candidates.json / videos.json / transcripts live (relative to repo root)
ONRECORD_DATA_DIR=data/seed

# Address shown on the "report a problem" link
ONRECORD_REPORT_EMAIL=onrecord-reports@example.org

# Only for the offline ingest job (ingest/collect.py). Free plan: ~1 browser hour total.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Only for ingest/youtube_metadata.py: fills upload dates and durations from the official
# YouTube Data API v3 (Google Cloud console -> enable "YouTube Data API v3" -> Credentials -> API key).
YOUTUBE_API_KEY=

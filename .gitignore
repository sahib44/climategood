# Secrets
.env
.env.*
!.env.example

# Real transcripts ARE committed (official captions only, private repo) so the demo machine
# never has to re-fetch from YouTube. Local Gemini caches and stray files are not.
data/transcripts/*
!data/transcripts/*.json
data/transcripts/*.proposals.json
data/transcripts/*.tmp
# Problem reports are local only
data/reports/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Node
node_modules/
frontend/dist/

# OS / editors
.DS_Store
.vscode/
.idea/

# Teamboard (local state and secret)
tools/teamboard/board.db
tools/teamboard/.token
.claude/settings.local.json
tools/teamboard/*.log

# Ingest job: local evidence screenshots, run state, raw finds (may hold page text). Only
# data/real/ (human-approved metadata) and data/ingest/coverage.json are committed.
data/ingest/evidence/
data/ingest/progress.json
data/ingest/proposed/
data/ingest/rejected/
data/ingest/log.jsonl
data/ingest/manual_queue.csv
data/ingest/link_check.json
data/ingest/manual_rows.csv

# Vercel project link (local)
.vercel
